# --- Local source database (docker compose) ---
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
PG_DSN=postgresql://payments:payments@localhost:5432/payments

# --- AWS (fill from `terraform output`) ---
AWS_REGION=us-east-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Snowflake (service user created by Terraform, key from `make keys`) ---
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=PAYMENTS_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=../keys/svc_key.p8
DBT_USER=yourname
